@model IEnumerable<KhachSan>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý khách sạn";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-primary mb-0"><i class="bi bi-building me-2"></i>Khách sạn</h2>
    <a asp-action="Tao" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm mới</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Ảnh</th>
                    <th>Tên</th>
                    <th>Khu vực</th>
                    <th>Sao</th>
                    <th>K.cách biển</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var ks in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(ks.HinhAnh))
                        {
                            <img src="@ks.HinhAnh" alt="" class="rounded" style="width:56px;height:40px;object-fit:cover;" />
                        }
                    </td>
                    <td class="fw-semibold">@ks.TenKhachSan</td>
                    <td>@ks.KhuVuc</td>
                    <td>@ks.XepHang <i class="bi bi-star-fill text-warning small"></i></td>
                    <td>@ks.KhoangCachBien m</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Sua" asp-route-id="@ks.MaKhachSan" class="btn btn-sm btn-outline-primary">Sửa</a>
                        <form asp-action="Xoa" asp-route-id="@ks.MaKhachSan" method="post" class="d-inline"
                              onsubmit="return confirm('Xóa khách sạn này?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
