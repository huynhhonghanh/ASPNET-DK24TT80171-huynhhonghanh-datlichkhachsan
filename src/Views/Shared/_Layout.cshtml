<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Đặt phòng Vũng Tàu</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DatPhongKhachSanVungTau.styles.css" asp-append-version="true" />
</head>
<body>
@using DatPhongKhachSanVungTau.Models
@using DatPhongKhachSanVungTau.Services
@{
    var hoTen = Context.Session.GetString(PhienDangNhap.KhoaHoTen);
    var vaiTro = Context.Session.GetString(PhienDangNhap.KhoaVaiTro);
    var daDangNhap = !string.IsNullOrWhiteSpace(hoTen);
    var laAdmin = string.Equals(vaiTro, HangSo.VaiTroAdmin, StringComparison.OrdinalIgnoreCase);
}
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark navbar-bien mb-3">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-water me-1"></i> Vũng Tàu Booking
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarChinh"
                        aria-controls="navbarChinh" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarChinh">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Phong" asp-action="TimKiem">Tìm phòng</a>
                        </li>
                        @if (daDangNhap && !laAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="DatPhong" asp-action="LichSu">Lịch sử đặt phòng</a>
                            </li>
                        }
                        @if (laAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Admin/Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i> Admin
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (!daDangNhap)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TaiKhoan" asp-action="DangNhap">
                                    <i class="bi bi-person-circle me-1"></i> Đăng nhập
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TaiKhoan" asp-action="DangKy">Đăng ký</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-check me-1"></i> @hoTen
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <span class="dropdown-item-text text-muted small">
                                            Vai trò: @vaiTro
                                        </span>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="TaiKhoan" asp-action="DangXuat" method="post" class="px-3">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger w-100">
                                                <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-bien mt-auto">
        <div class="container text-center">
            <p class="mb-0">
                &copy; @DateTime.Now.Year - Hệ thống đặt phòng khách sạn ven biển Vũng Tàu
            </p>
            <small class="opacity-75">Đồ án tốt nghiệp — Bãi Trước · Bãi Sau · Bãi Dâu · Bãi Dứa · Bãi Vọng Nguyệt</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
