@model DatPhongKhachSanVungTau.ViewModels.DangKyViewModel
@{
    ViewData["Title"] = "Đăng ký";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="fw-bold mb-1">Đăng ký tài khoản</h3>
                <p class="text-muted mb-4">Tạo tài khoản khách hàng để đặt phòng.</p>

                <form asp-action="DangKy" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="TenDangNhap" class="form-label"></label>
                            <input asp-for="TenDangNhap" class="form-control" autocomplete="username" />
                            <span asp-validation-for="TenDangNhap" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="HoTen" class="form-label"></label>
                            <input asp-for="HoTen" class="form-control" autocomplete="name" />
                            <span asp-validation-for="HoTen" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="SoDienThoai" class="form-label"></label>
                            <input asp-for="SoDienThoai" class="form-control" autocomplete="tel" />
                            <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="MatKhau" class="form-label"></label>
                            <input asp-for="MatKhau" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="MatKhau" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="NhapLaiMatKhau" class="form-label"></label>
                            <input asp-for="NhapLaiMatKhau" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="NhapLaiMatKhau" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CCCD" class="form-label"></label>
                            <input asp-for="CCCD" class="form-control" />
                            <span asp-validation-for="CCCD" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="DiaChi" class="form-label"></label>
                            <input asp-for="DiaChi" class="form-control" />
                            <span asp-validation-for="DiaChi" class="text-danger"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-bien w-100">
                        <i class="bi bi-person-plus me-1"></i> Đăng ký
                    </button>

                    <div class="text-center mt-3">
                        <a asp-action="DangNhap" class="text-decoration-none">Đã có tài khoản? Đăng nhập</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

