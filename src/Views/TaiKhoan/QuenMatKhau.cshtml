@model DatPhongKhachSanVungTau.ViewModels.QuenMatKhauViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="fw-bold mb-1">Quên mật khẩu</h3>
                <p class="text-muted mb-4">
                    Demo đồ án: hệ thống sẽ tạo mật khẩu tạm và hiển thị trực tiếp (không gửi email).
                </p>

                <form asp-action="QuenMatKhau" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-bien w-100">
                        <i class="bi bi-key me-1"></i> Tạo mật khẩu tạm
                    </button>
                </form>

                @if (ViewBag.MatKhauTam != null)
                {
                    <div class="alert alert-warning mt-4 mb-0">
                        <div class="fw-bold mb-1">Mật khẩu tạm của bạn:</div>
                        <div class="fs-4"><code>@ViewBag.MatKhauTam</code></div>
                        <div class="small text-muted mt-2">
                            Vui lòng đăng nhập và đổi mật khẩu ở Bước tiếp theo.
                        </div>
                    </div>
                }

                <div class="text-center mt-3">
                    <a asp-action="DangNhap" class="text-decoration-none">Quay lại đăng nhập</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

