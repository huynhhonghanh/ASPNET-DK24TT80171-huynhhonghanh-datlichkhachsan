@model DatPhongKhachSanVungTau.ViewModels.DangNhapViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="fw-bold mb-1">Đăng nhập</h3>
                <p class="text-muted mb-4">Vui lòng nhập thông tin để tiếp tục.</p>

                @if (TempData["ThongBao"] != null)
                {
                    <div class="alert alert-success">@TempData["ThongBao"]</div>
                }

                <form asp-action="DangNhap" method="post" class="needs-validation" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="TenDangNhap" class="form-label"></label>
                        <input asp-for="TenDangNhap" class="form-control" autocomplete="username" />
                        <span asp-validation-for="TenDangNhap" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MatKhau" class="form-label"></label>
                        <input asp-for="MatKhau" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="MatKhau" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-bien w-100">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                    </button>

                    <div class="d-flex justify-content-between mt-3">
                        <a asp-action="DangKy" class="text-decoration-none">Tạo tài khoản</a>
                        <a asp-action="QuenMatKhau" class="text-decoration-none">Quên mật khẩu?</a>
                    </div>

                    <hr class="my-4" />
                    <div class="small text-muted">
                        Tài khoản demo: <b>admin / Admin@123</b>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

